# Copy this file to .env.local and fill it in. .env.local is never committed.

# Postgres connection string.
#   Local:  postgres://postgres:postgres@localhost:5432/team_reports   (see docker-compose.yml)
#   Neon:   the pooled connection string, e.g.
#           postgres://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/team_reports

# The one shared team password, asked for on /login.
SITE_PASSWORD=change-me

# A second password for /admin (people and API tokens).
ADMIN_PASSWORD=change-me-too

# Signs the login cookies. Use a long random value, at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-value

# Optional. Only used by `npm test` for the database tests. Point it at a
# throwaway database, never at real data. Without it those tests are skipped.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/team_reports_test

# Optional. A password for the CEO. Signing in with it (instead of SITE_PASSWORD) gives the
# CEO view: no report forms, but the CEO can answer decisions, mark reports as seen and
# leave notes. Without it nobody can sign in as the CEO.
# CEO_PASSWORD=another-different-password

# Optional. The Thursday email for the CEO (see docs/deployment.md, "Weekly email").
# CRON_SECRET is the secret the scheduler sends (Vercel adds it for you). The email goes out
# through Resend. Without these the /api/digest route sends nothing.
# CRON_SECRET=a-long-random-value
# RESEND_API_KEY=re_xxxxxxxx
# DIGEST_FROM=Team Reports <reports@your-domain.com>
# DIGEST_TO=ceo@your-company.com
